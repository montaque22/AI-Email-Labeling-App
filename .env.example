DATABASE_URL=postgres://user:password@host:5432/database
PORT=3000
BETTER_AUTH_URL=https://your-app-domain.com
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret
# Optional: use a separate HMAC key for reconstructing per-user activity callback credentials.
# Defaults to BETTER_AUTH_SECRET when omitted.
ACTIVITY_CALLBACK_SECRET_KEY=replace-with-a-strong-random-secret
ACTIVITY_CALLBACK_DAILY_LIMIT=500
ACTIVITY_CALLBACK_RATE_PER_SECOND=5
ACTIVITY_CALLBACK_BURST_LIMIT=10
ACTIVITY_CALLBACK_MAX_BYTES=65536
POST_PROCESSING_ATTACHMENT_MAX_BYTES=1000000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
EMAIL_ACCOUNT_TOKEN_SECRET=replace-with-a-strong-random-secret-for-email-account-tokens
YAHOO_CLIENT_ID=your-yahoo-oauth-client-id
YAHOO_CLIENT_SECRET=your-yahoo-oauth-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-entra-application-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-entra-client-secret
