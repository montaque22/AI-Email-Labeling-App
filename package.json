{
  "private": true,
  "version": "0.1.88",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file-if-exists=.env.local --env-file-if-exists=.env server/index.js",
    "dev:local": "LOCAL_DEV_AUTH=true node --env-file-if-exists=.env.local --env-file-if-exists=.env server/index.js",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed-local": "node --env-file-if-exists=.env.local scripts/seed-local-db.js",
    "db:reset-local": "node --env-file-if-exists=.env.local scripts/reset-local-db.js",
    "start": "node --env-file-if-exists=.env.local --env-file-if-exists=.env server/index.js",
    "auth:migrate": "npx auth@latest migrate --config server/auth.js --yes",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.8",
    "@ai-sdk/google": "^4.0.8",
    "@ai-sdk/openai": "^4.0.8",
    "@ai-sdk/openai-compatible": "^3.0.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-slot": "latest",
    "@tailwindcss/vite": "latest",
    "@vitejs/plugin-react": "latest",
    "ai": "^7.0.15",
    "better-auth": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "express": "latest",
    "imapflow": "^1.3.7",
    "lucide-react": "latest",
    "mailparser": "^3.9.14",
    "motion": "^12.42.2",
    "node-ical": "^0.27.1",
    "nodemailer": "^8.0.11",
    "pg": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "embedded-postgres": "18.4.0-beta.17",
    "jsdom": "^29.1.1",
    "prisma": "latest",
    "supertest": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  }
}
